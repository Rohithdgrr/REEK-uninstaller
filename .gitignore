# Rust build artifacts
/target/
**/*.rs.bk

# NOTE: Cargo.lock is intentionally NOT ignored. REEK ships binaries, so the
# lockfile must be committed to guarantee reproducible builds and to pin the
# exact dependency versions used by CI and releases (supply-chain integrity).

# Tooling
rustup-init.exe

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Security audit output (cargo audit output-path)
audit-report.txt

# Test coverage
tarpaulin-report.html
cobertura.xml

# Backup files
*.bak
*.backup
