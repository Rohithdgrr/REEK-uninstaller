{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "REEK Uninstaller",
  "version": "0.1.0",
  "identifier": "com.reek.uninstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "REEK Uninstaller",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IHJlcGxhY2UgdGhpcyB3aXRoIHlvdXIgZ2VuZXJhdGVkIHB1YmtleSB2aWEgYG5wbSBydW4gdGF1cmkgc2lnbmVyIGdlbmVyYXRlYC4gU2VlIGRvY3MvQ0lfQ0QuIG1k",
      "endpoints": [
        "https://github.com/Rohithdgrr/REEK-uninstaller/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
